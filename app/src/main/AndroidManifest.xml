<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No internet: nothing the app holds can leave the phone through it. -->

    <!-- Alarms that ring at the minute they are set for. On Android 12 this is given at install;
         if it is taken away, the first screen says so and asks for it back. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- An alarm does not survive a restart: this is how they are set again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The ringing screen over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- The service that plays the sound until the alarm is answered. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Keeps the phone awake while it rings, so the sound and the stop after the set time both happen. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets the first screen ask for the phone's battery saving to leave the app alone, which
         stops alarms coming minutes late after a night asleep. Asked, never assumed. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Asked for by Android 13 and later; Android 12, the Kompakt's, has notifications on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The other apps that act on selected text, so a field's selection menu can list them
         behind its ⋮ as every other app of this shop does. -->
    <queries>
        <!-- Sky, for the line of weather on the ringing screen. -->
        <package android:name="com.wanderwildwood.soramoyo" />
        <!-- DuraSpeed, the Kompakt's background manager: only to say whether it is there. -->
        <package android:name="com.mediatek.duraspeed" />
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_mudita"
        android:roundIcon="@drawable/ic_launcher_mudita"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- What other apps ask a clock to show: the alarms, the timers, the stopwatch, the
             clock. Anyone may ask; nothing is changed by it. -->
        <activity
            android:name=".ApiActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <action android:name="android.intent.action.SHOW_TIMERS" />
                <action android:name="com.android.deskclock.action.SHOW_TIMERS" />
                <action android:name="com.android.deskclock.action.SHOW_STOPWATCH" />
                <action android:name="com.android.deskclock.action.SHOW_CLOCK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- What other apps ask a clock to do: set, snooze or stop an alarm or a timer, run the
             stopwatch. Only apps holding SET_ALARM may ask, as with Android's own clock. -->
        <activity-alias
            android:name=".SetAlarmApi"
            android:targetActivity=".ApiActivity"
            android:exported="true"
            android:permission="com.android.alarm.permission.SET_ALARM">
            <intent-filter>
                <action android:name="android.intent.action.SET_ALARM" />
                <action android:name="android.intent.action.DISMISS_ALARM" />
                <action android:name="android.intent.action.SNOOZE_ALARM" />
                <action android:name="android.intent.action.SET_TIMER" />
                <action android:name="android.intent.action.DISMISS_TIMER" />
                <action android:name="com.android.deskclock.action.START_STOPWATCH" />
                <action android:name="com.android.deskclock.action.PAUSE_STOPWATCH" />
                <action android:name="com.android.deskclock.action.LAP_STOPWATCH" />
                <action android:name="com.android.deskclock.action.RESET_STOPWATCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- The ringing screen over the lock screen. Its own task, out of Recents, so answering it
             leaves the phone where it was. -->
        <activity
            android:name=".alarm.RingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.wanderwildwood.tokei.ringing"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <service
            android:name=".alarm.RingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".alarm.ActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".alarm.SystemReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- The next alarm for Glance's lock-screen panel; it answers Glance alone, and only
             while the switch for it in Settings is on. -->
        <provider
            android:name=".glance.NextAlarmOnLockScreen"
            android:authorities="com.wanderwildwood.tokei.glance"
            android:exported="true" />

    </application>

</manifest>
